# Canonical site URL used for SEO tags and the mailto subject fallback.
VITE_SITE_URL=https://martynov.dev

# Web3Forms endpoint for the contact form. Leave empty to fall back to the
# visitor's mail client (mailto:) instead of a POST.
VITE_CONTACT_ENDPOINT=

# Web3Forms public access key (used only when the endpoint is set).
VITE_CONTACT_ACCESS_KEY=
